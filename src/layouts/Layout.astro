---
import '../styles/global.css';
import SearchDialog from '../components/SearchDialog.astro';
import Icon from '../components/Icon.astro';
import Checkin from '../components/Checkin.astro';
import Report from '../components/Report.astro';
interface Props {
  title?: string;
  description?: string;
}
const { title = '一班集', description = '一班集，一间安静、克制、适合阅读的中文数字刊物。' } =
  Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f5ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/ReadingSerif.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title === '一班集' ? title : `${title} · 一班集`}</title>
    <script is:inline>
      (() => {
        let theme = 'system';
        try {
          theme = localStorage.getItem('yb_theme') || 'system';
        } catch {
          /* Reading stays available without storage. */
        }
        document.documentElement.dataset.theme =
          theme === 'dark' ||
          (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
            ? 'dark'
            : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="一班集首页">
        <img class="brand-mark" src="/favicon.svg" width="30" height="30" alt="" />
        一班集<span>文字留住时光</span>
      </a>
      <nav aria-label="主导航">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>
          首页
        </a>
        <a href="/catalog/" aria-current={path.startsWith('/catalog') ? 'page' : undefined}>
          目录
        </a>
        <a
          href="/submissions/"
          aria-current={
            path.startsWith('/submissions') || path.startsWith('/write') ? 'page' : undefined
          }
        >
          投稿
        </a>
        <a href="/community/" aria-current={path.startsWith('/community') ? 'page' : undefined}>
          社区
        </a>
      </nav>
      <div class="header-actions">
        <a data-search-open class="search-link" href="/search/" aria-label="搜索文集">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 5 5" />
          </svg>
          <span>搜索</span>
          <kbd>⌘ K</kbd>
        </a>
        <button id="theme-toggle" class="icon-button" aria-label="切换到夜间模式">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" />
          </svg>
        </button>
        <a
          class="icon-button notification-link"
          href="/notifications/"
          aria-label="消息"
          data-auth-only
          hidden
        >
          <Icon name="bell" />
          <span data-notification-count></span>
        </a>
        <details class="user-menu">
          <summary aria-label="打开个人菜单">
            <span class="avatar" aria-hidden="true">
              读
            </span>
            <span class="user-menu-label">我的书房</span>
          </summary>
          <nav aria-label="个人菜单">
            <p class="menu-caption">我的书房</p>
            <a href="/auth/" data-guest-only>
              登录 / 注册
            </a>
            <a href="/me/" data-my-profile data-auth-only hidden>
              我的主页
            </a>
            <a href="/me/writing/">我的创作</a>
            <a href="/write/">写一篇文章</a>
            <a href="/me/bookmarks/">我的收藏</a>
            <a href="/me/history/">阅读历史</a>
            <a href="/notifications/" data-auth-only hidden>
              消息<span data-notification-count></span>
            </a>
            <button data-open-checkin data-auth-only hidden>
              每日签到
            </button>
            <a href="/me/rewards/">奖励与任务</a>
            <a href="/me/settings/">阅读设置</a>
            <a href="/community/guidelines/">社区规范</a>
            <a href="/admin/moderation/" data-admin-only hidden>
              社区管理
            </a>
            <button data-signout data-auth-only hidden>
              退出登录
            </button>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="footer-brand" href="/">
          一班集
        </a>
        <p>有些时光，值得写下来。</p>
      </div>
      <div class="footer-links">
        <a href="/catalog/">文集目录</a>
        <a href="/community/guidelines/">社区规范</a>
        <span>九卷 · 五十四篇</span>
      </div>
    </footer>
    <div id="status" role="status" aria-live="polite"></div>
    <Checkin />
    <Report />
    <SearchDialog />
    <script>
      import '../scripts/site';
    </script>
    <script>
      import '../scripts/auth';
    </script>
  </body>
</html>
