---
import Icon from './Icon.astro';
import PdfPreview from './PdfPreview.astro';
interface Props {
  id: string;
  title: string;
  chapterTitle?: string;
  chapter?: number;
  novel?: boolean;
  source?: 'catalog' | 'submission';
}
const { id, title, chapterTitle, chapter, novel, source = 'catalog' } = Astro.props;
const pdf = '/pdf/' + id + (chapter ? '-' + chapter : '') + '.pdf';
---

<section class="reader-actions" data-interactions={id} aria-label="文章互动">
  <div class="article-actions">
    <button data-like aria-pressed="false">
      <Icon name="heart" />
      <span data-action-label>点赞</span>
    </button>
    <a class="rail-action" href="#comments">
      <Icon name="comment" />
      <span>评论</span>
    </a>
    <button data-article-bookmark aria-pressed="false">
      <Icon name="bookmark" />
      <span data-action-label>收藏</span>
    </button>
    {source === 'catalog' ? (
      <a
        class="rail-action"
        data-pdf-open
        href={pdf}
        aria-haspopup="dialog"
        aria-controls="pdf-dialog"
        data-astro-prefetch="false"
      >
        <Icon name="download" />
        <span>PDF 预览</span>
      </a>
    ) : (
      <button data-print>
        <Icon name="download" />
        <span>打印 / PDF</span>
      </button>
    )}
    <button data-share>
      <Icon name="share" />
      <span>分享链接</span>
    </button>
    <button data-focus-reading aria-pressed="false">
      <Icon name="focus" />
      <span>沉浸阅读</span>
    </button>
    <button data-egg-open>
      <Icon name="egg" />
      <span>臭鸡蛋</span>
    </button>
  </div>
  <div class="article-statistics" data-article-stats aria-live="polite">
    <span class="muted">互动加载中</span>
  </div>
  <dialog id="egg-dialog" aria-labelledby="egg-title">
    <form method="dialog">
      <button class="dialog-close" aria-label="关闭投掷面板">
        关闭
      </button>
    </form>
    <h2 id="egg-title">给文章扔臭鸡蛋</h2>
    <p data-egg-wallet>正在打开钱包…</p>
    <form id="egg-form">
      <label>
        投掷数量
        <input name="quantity" type="number" min="1" max="50" value="1" required />
      </label>
      <div class="egg-actions">
        <button type="button" data-quantity="1">
          扔 1 枚
        </button>
        <button type="button" data-quantity="5">
          扔 5 枚
        </button>
        <button>按数量投掷</button>
      </div>
    </form>
    <p data-egg-result role="status"></p>
    <p class="muted">只面向文章内容，可以重复投掷；点赞和臭鸡蛋互不冲突。</p>
  </dialog>
</section>
{source === 'catalog' && <PdfPreview {id} {title} {chapterTitle} {chapter} {novel} />}
<script>
  import '../scripts/article-interactions';
</script>
