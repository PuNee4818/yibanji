---
interface Props {
  kind: 'bookmarks' | 'history';
}
const { kind } = Astro.props;
---

<section class="submission-library" data-submission-library={kind}>
  <div class="section-heading">
    <h2>投稿作品</h2>
    <a href="/submissions/">读读新作 ↗</a>
  </div>
  <p data-submission-library-state role="status">
    正在加载记录…
  </p>
  <div class="submission-grid" data-submission-library-list></div>
  <button class="submission-more" data-submission-library-more hidden>
    查看更多
  </button>
</section>
<script>
  import '../scripts/submission-library';
</script>
