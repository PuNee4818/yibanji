<div class="settings-fields">
  <label>外观<select data-preference="theme"><option value="system">跟随系统</option><option value="light">日间</option><option value="dark">夜间</option></select></label>
  <label>正文字体<select data-preference="face"><option value="serif">宋体</option><option value="kai">楷体</option><option value="sans">黑体</option></select></label>
  <label>正文字号<select data-preference="size"><option value="17">小 · 17</option><option value="19">标准 · 19</option><option value="21">大 · 21</option><option value="24">特大 · 24</option></select></label>
  <label>行距<select data-preference="line"><option value="1.72">紧凑</option><option value="1.95">舒适</option><option value="2.16">宽松</option></select></label>
  <label>版心<select data-preference="width"><option value="650">窄</option><option value="760">标准</option><option value="880">宽</option></select></label>
  <button data-reset-preferences>恢复默认</button>
</div>
