---
import { writingBlocks, inlineWriting, isVerse } from '../lib/submissions';
interface Props {
  body: string;
  genre: string;
  indent?: boolean;
}
const { body, genre, indent = true } = Astro.props;
---

<div
  class:list={[
    'writing-prose',
    { 'writing-verse': isVerse(genre), 'writing-indent': indent && !isVerse(genre) },
  ]}
>
  {writingBlocks(body, isVerse(genre)).map((block, i) => {
    const Tag = block.kind === 'heading' ? 'h2' : block.kind === 'quote' ? 'blockquote' : 'p';
    return block.kind === 'break' ? (
      <hr />
    ) : (
      <Tag id={block.kind === 'heading' ? `writing-section-${i}` : undefined}>
        {inlineWriting(block.text).map((part) =>
          part.strong ? <strong>{part.text}</strong> : part.text,
        )}
      </Tag>
    );
  })}
</div>
