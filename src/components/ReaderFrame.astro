---
import ArticleActions from './ArticleActions.astro';
interface Props {
  id: string;
  title: string;
  genre: string;
  source?: 'catalog' | 'submission';
  chapter?: number;
  chapterTitle?: string;
  novel?: boolean;
}
const { id, title, genre, source = 'catalog', chapter, chapterTitle, novel } = Astro.props;
---

<div class="reading-progress" aria-hidden="true">
  <span data-reading-progress></span>
</div>
<div class="reader-layout" data-genre={genre}>
  <aside class="reader-toc" aria-label="阅读目录">
    <slot name="toc" />
  </aside>
  <article class="reader" data-article-id={id} data-chapter={chapter ?? 1} data-source={source}>
    <slot />
  </article>
  <ArticleActions {id} {title} {chapter} {chapterTitle} {novel} {source} />
</div>
<div class="focus-controls" hidden>
  <button data-focus-settings>阅读设置 Aa</button>
  <button class="exit-focus">
    退出沉浸阅读 <kbd>Esc</kbd>
  </button>
</div>
<script>
  import '../scripts/reader';
</script>
