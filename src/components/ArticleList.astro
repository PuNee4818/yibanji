---
import { articleUrl, type Article } from '../lib/book';
import { genreOf, genreNames } from '../lib/presentation';
interface Props {
  articles: Article[];
  bookmarkList?: boolean;
}
const { articles, bookmarkList = false } = Astro.props;
---

<ul class="article-list">
  {articles.map((article) => (
    <li
      data-genre={genreOf(article)}
      data-bookmark-item={bookmarkList ? article.id : undefined}
      hidden={bookmarkList}
    >
      <a href={articleUrl(article)}>
        <span>{article.title}</span>
        <small>
          {article.author} · {genreNames[genreOf(article)]}
        </small>
      </a>
    </li>
  ))}
</ul>
