---
import AuthorBadge from '../../components/AuthorBadge.astro';
import { levelNames, normalizedLevel } from '../../lib/growth';
import Layout from '../../layouts/Layout.astro';
import ReaderFrame from '../../components/ReaderFrame.astro';
import Discussion from '../../components/Discussion.astro';
import ReadingSettings from '../../components/ReadingSettings.astro';
import WritingBody from '../../components/WritingBody.astro';
import SubmissionCard from '../../components/SubmissionCard.astro';
import { supabase } from '../../lib/supabase';
import { submissionGenres, formattedWriting, type Submission } from '../../lib/submissions';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Astro.params.id || '';
const valid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);
const { data, error } = valid
  ? await supabase.from('submission_public').select('*').eq('id', id).maybeSingle()
  : { data: null, error: null };
const item = data as Submission | null;
if (!item) Astro.response.status = error ? 503 : 404;
const headings = item
  ? formattedWriting(item.body!, item.genre)
      .map((block, index) => ({ ...block, index }))
      .filter((block) => block.kind === 'heading')
  : [];
let related: Submission[] = [];
if (item) {
  const { data: rows } = await supabase.rpc('submission_feed', { p_genre: item.genre });
  related = (rows || []).filter((row: Submission) => row.id !== id).slice(0, 2);
}
---

<Layout title={item?.title || '来稿阅读'} description={item?.summary || '阅读一班集的自由来稿。'}>
  {item ? (
    <div
      class="submission-reading"
      data-submission-reader={item.id}
      data-submission-author={item.user_id}
    >
      <ReaderFrame id={item.id} title={item.title} genre={item.genre} source="submission">
        <Fragment slot="toc">
          <details class="toc-tree" open>
            <summary>
              目录 <span>／ {submissionGenres[item.genre]}</span>
            </summary>
            <nav aria-label="文章目录">
              <a class="toc-back" href="/submissions/">
                ← 返回自由来稿
              </a>
              <div class="toc-work">
                <a href="#submission-title">{item.title}</a>
                <ol>
                  {headings.map((h) => (
                    <li>
                      <a href={'#writing-section-' + h.index}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </div>
              <a href={'/u/' + encodeURIComponent(item.username) + '/?stream=works'}>
                作者的其他作品 ↗
              </a>
            </nav>
          </details>
        </Fragment>
        <nav class="reader-breadcrumb" aria-label="阅读位置">
          <a href="/submissions/">自由来稿</a>
          <span>／</span>
          <a href={'/submissions/?genre=' + item.genre}>{submissionGenres[item.genre]}</a>
        </nav>
        <header class="article-head">
          <p class="eyebrow">{submissionGenres[item.genre]} · 自由来稿</p>
          <h1 id="submission-title">{item.title}</h1>
          <div class="submission-card-foot">
            <div class="author-identity">
              <a class="submission-author" href={'/u/' + encodeURIComponent(item.username) + '/'}>
                {item.display_name} ↗
              </a>
              {item.level && (
                <span class="level-badge" data-level={normalizedLevel(item.level)}>
                  {levelNames[normalizedLevel(item.level) - 1]}
                </span>
              )}
              {item.author_verified && <AuthorBadge />}
            </div>
            <span class="muted small">
              {new Date(item.published_at).toLocaleDateString('zh-CN')} ·{' '}
              {item.word_count.toLocaleString()} 字 · 约{' '}
              {Math.max(1, Math.ceil(item.word_count / 450))} 分钟
            </span>
          </div>
          <div class="submission-tags">
            {item.tags.map((tag) => (
              <a href={'/submissions/?tag=' + encodeURIComponent(tag)}>#{tag}</a>
            ))}
          </div>
        </header>
        <div class="reader-options">
          <details>
            <summary>
              阅读设置 <span aria-hidden="true">Aa</span>
            </summary>
            <ReadingSettings />
          </details>
        </div>
        <div class="submission-body" aria-label="文章正文">
          <WritingBody body={item.body!} genre={item.genre} indent={item.indent} />
        </div>
        <p class="reading-end" aria-hidden="true">
          · · ·
        </p>
        <div class="submission-reader-actions">
          <button disabled data-submission-follow aria-pressed="false">
            关注作者
          </button>
          <a class="button" href={'/write/?draft=' + item.id} data-submission-edit hidden>
            编辑作品
          </a>
        </div>
        <Discussion kind="article" target={item.id} />
        <section class="submission-related">
          <div class="section-heading">
            <h2>继续翻一页</h2>
            <a href={'/u/' + encodeURIComponent(item.username) + '/?stream=works'}>
              这位作者的其他作品 ↗
            </a>
          </div>
          <div class="submission-grid">
            {related.map((row) => (
              <SubmissionCard item={row} />
            ))}
          </div>
          <div class="submission-actions">
            <a href="/submissions/">回到自由来稿 →</a>
            <a href="/write/">也写下一篇 ↗</a>
          </div>
        </section>
      </ReaderFrame>
    </div>
  ) : (
    <section class="submission-empty">
      <h1>{error ? '这一页暂时没有打开' : '这篇文字暂时不可阅读'}</h1>
      <p>{error ? '请稍后重试，或先看看其他来稿。' : '作品可能尚未发布、已撤回或已删除。'}</p>
      <a class="button" href="/submissions/">
        去阅读其他来稿 →
      </a>
    </section>
  )}
  <script>
    import '../../scripts/submission-reader';
  </script>
</Layout>
