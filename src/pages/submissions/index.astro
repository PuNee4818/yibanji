---
import Layout from '../../layouts/Layout.astro';
import SubmissionDiscovery from '../../components/SubmissionDiscovery.astro';
import SubmissionArt from '../../components/SubmissionArt.astro';
import { submissionGenres, submissionTags } from '../../lib/submissions';
---

<Layout
  title="自由投稿"
  description="在一班集发表散文、诗歌、小说，阅读新作、关注作者。草稿随时保存，作品发布后即可阅读。"
>
  <section class="submission-masthead">
    <div>
      <p class="eyebrow">
        <span class="red-dot"></span> 一班集 · 自由投稿
      </p>
      <h1>
        还有些话，
        <br />
        想写下来。
      </h1>
      <p class="submission-intro">
        一件小事，也可以写得很长。
        <br />
        散文、诗歌、小说，都欢迎。没写完的，先存为草稿。
      </p>
      <div class="submission-actions">
        <a class="button primary" href="/write/">
          写一篇文章 ↗
        </a>
        <a href="/me/writing/">我的创作 →</a>
      </div>
    </div>
    <SubmissionArt />
  </section>
  <SubmissionDiscovery />
  <section class="submission-discovery" aria-labelledby="submission-feed-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">读点新的</p>
        <h2 id="submission-feed-title">刚落在纸上的文字</h2>
      </div>
      <button type="button" data-submission-random class="quiet-button">
        偶遇一篇 ↗
      </button>
    </div>
    <nav class="submission-feed-tabs" aria-label="作品动态">
      <button data-feed-tab="latest" aria-pressed="true">
        最新发表
      </button>
      <button data-feed-tab="popular" aria-pressed="false">
        热门作品
      </button>
      <button data-feed-tab="following" aria-pressed="false">
        关注作者
      </button>
    </nav>
    <form class="submission-filters" id="submission-filters" role="search">
      <div class="submission-search">
        <label class="sr-only" for="submission-query">
          搜索投稿作品
        </label>
        <input
          id="submission-query"
          name="q"
          type="search"
          maxlength="100"
          placeholder="篇名、作者，或记得的一句话"
        />
        <button type="submit">搜索 →</button>
      </div>
      <div class="submission-filter-row">
        <label>
          文体
          <select name="genre">
            <option value="">全部文体</option>
            {Object.entries(submissionGenres).map(([key, label]) => (
              <option value={key}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          主题
          <select name="tag">
            <option value="">全部主题</option>
            {submissionTags.map((tag) => (
              <option>{tag}</option>
            ))}
          </select>
        </label>
        <label>
          排序
          <select name="sort">
            <option value="latest">最新发表</option>
            <option value="popular">近期受欢迎</option>
            <option value="following">我关注的</option>
          </select>
        </label>
        <label class="submission-short">
          <input type="checkbox" name="short" /> 读一篇短文 <small>千字以内</small>
        </label>
      </div>
    </form>
    <div class="submission-feed-status">
      <p role="status" data-submission-status>
        正在加载作品…
      </p>
      <button type="button" data-submission-reset class="quiet-button" hidden>
        清除筛选
      </button>
    </div>
    <div class="submission-grid" data-submission-list aria-busy="true"></div>
    <button class="submission-more" data-submission-more hidden>
      查看更多作品
    </button>
    <noscript>
      <p>请启用 JavaScript 浏览与搜索投稿作品。通过作品链接可以直接阅读全文。</p>
    </noscript>
  </section>
  <script>
    import '../../scripts/submissions';
  </script>
</Layout>
