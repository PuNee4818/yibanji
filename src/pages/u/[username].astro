---
import AuthorBadge from '../../components/AuthorBadge.astro';
import ArticleList from '../../components/ArticleList.astro';
import { book } from '../../lib/book';
import LevelGallery from '../../components/LevelGallery.astro';
import ProfileEditor from '../../components/ProfileEditor.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { normalizedLevel, levelNames, levelDescriptions } from '../../lib/growth';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const { data: profile, error } = await supabase
  .from('profile_summaries')
  .select('*')
  .eq('username', Astro.params.username ?? '')
  .maybeSingle();
if (!profile) Astro.response.status = error ? 503 : 404;
const { data: progress } = profile
  ? await supabase.from('user_progress').select('level').eq('user_id', profile.id).maybeSingle()
  : { data: null };
const level = progress ? normalizedLevel(progress.level) : null;
const { data: authored } = profile
  ? await supabase.from('articles').select('id').eq('source', 'catalog').eq('author_id', profile.id)
  : { data: [] };
const catalogWorks = book.articles.filter((a) => authored?.some((row) => row.id === a.id));
---

<Layout title={profile?.display_name ?? '书友主页'}>
  {profile ? (
    <section
      class="profile-page"
      data-profile-id={profile.id}
      data-profile-name={profile.display_name}
      data-profile-username={profile.username}
      data-profile-bio={profile.bio || ''}
    >
      <div class="profile-preview-notice" data-profile-preview-notice hidden role="status">
        <span>正在预览他人看到的主页。预览中的关注与互动不可用。</span>
        <button data-profile-preview-exit>返回我的视角</button>
      </div>
      <header class="profile-hero">
        <div class="profile-avatar" aria-hidden="true">
          {Array.from(profile.display_name)[0] || '读'}
        </div>
        <div class="profile-identity">
          <p class="eyebrow">
            书友 /{' '}
            <span data-profile-handle title={profile.username}>
              @{profile.username}
            </span>
          </p>
          <div class="profile-name">
            <h1 data-profile-display-name>{profile.display_name}</h1>
            <span data-profile-level>
              {level && (
                <span
                  class="level-badge"
                  data-level={level}
                  aria-label={'等级 ' + level + '，' + levelNames[level - 1]}
                  title={levelDescriptions[level - 1]}
                >
                  {['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ'][level - 1]} {levelNames[level - 1]}
                </span>
              )}
            </span>
            {profile.author_verified && <AuthorBadge />}
          </div>
          <p class="profile-bio" data-profile-bio-text>
            {profile.bio || '在字里行间，慢慢相识。'}
          </p>
          <p class="profile-joined">
            加入于{' '}
            {new Date(profile.created_at).toLocaleDateString('zh-CN', {
              timeZone: 'Asia/Shanghai',
            })}
          </p>
        </div>
        <div class="profile-owner-actions" data-profile-owner hidden>
          <button class="button primary" data-profile-edit>
            <Icon name="note" size={16} />
            编辑资料
          </button>
          <button class="quiet-button" data-profile-preview aria-pressed="false">
            预览他人视角
          </button>
        </div>
        <div class="profile-public-actions" data-profile-public-actions>
          <button
            class="button primary"
            data-follow-user={profile.id}
            aria-pressed="false"
            disabled
          >
            关注
          </button>
          <button class="quiet-button" data-report-profile={profile.id}>
            举报用户
          </button>
        </div>
      </header>
      <nav class="profile-social" aria-label="社交关系">
        <button data-profile-relations="following">
          <strong data-following-count>{profile.following_count}</strong>
          <span>关注</span>
          <Icon name="arrow" size={14} />
        </button>
        <button data-profile-relations="followers">
          <strong data-follower-count>{profile.follower_count}</strong>
          <span>粉丝</span>
          <Icon name="arrow" size={14} />
        </button>
        <span class="profile-social-note">文字之外，还有同路人。</span>
      </nav>
      <section class="profile-private" data-profile-private hidden aria-label="我的成长">
        <details class="profile-growth-panel">
          <summary>
            <span>我的墨迹与成长</span>
            <small>查看等级与成长记录 · 仅自己可见</small>
          </summary>
          <div id="profile-growth" aria-live="polite">
            正在翻开成长记录…
          </div>
          <LevelGallery />
          <a href="/me/rewards/">查看奖励与任务 →</a>
        </details>
      </section>
      {catalogWorks.length > 0 && (
        <section class="profile-catalog-works">
          <div class="section-heading">
            <h2>收录于一班集</h2>
            <span class="muted small">{catalogWorks.length} 篇作品</span>
          </div>
          <ArticleList articles={catalogWorks} />
        </section>
      )}
      <section class="profile-publication" id="profile-activity">
        <div class="section-heading">
          <h2>留在这里的文字</h2>
          <a href="/me/writing/" data-profile-write hidden>
            我的创作 ↗
          </a>
        </div>
        <nav class="tabs" aria-label="个人活动类型">
          <a href="?stream=works" data-profile-stream="works">
            作品
          </a>
          <a href="?stream=posts" data-profile-stream="posts" aria-current="page">
            帖子
          </a>
          <a href="?stream=comments" data-profile-stream="comments">
            评论
          </a>
        </nav>
        <div data-profile-activity>正在翻开公开讨论…</div>
        <button data-profile-more hidden>
          查看更多活动
        </button>
      </section>
      <ProfileEditor />
      <dialog
        id="profile-relations-dialog"
        class="profile-relations-dialog"
        aria-labelledby="profile-relations-title"
      >
        <header class="profile-dialog-head">
          <h2 id="profile-relations-title">关注与粉丝</h2>
          <form method="dialog">
            <button class="icon-button" aria-label="关闭关注与粉丝">
              <Icon name="close" />
            </button>
          </form>
        </header>
        <div class="profile-relations-tabs" aria-label="关系类型">
          <button data-relations-tab="following" aria-pressed="true">
            关注
          </button>
          <button data-relations-tab="followers" aria-pressed="false">
            粉丝
          </button>
        </div>
        <div data-relations-list aria-live="polite"></div>
        <button data-relations-more hidden>
          查看更多书友
        </button>
      </dialog>
    </section>
  ) : (
    <section class="empty-state">
      <h1>{error ? '暂时无法打开主页' : '没有找到这位书友'}</h1>
      <a href="/community/">回到社区</a>
    </section>
  )}
  <script>
    import '../../scripts/profile';
  </script>
</Layout>
