---
import Layout from '../../layouts/Layout.astro';
import ReadingSettings from '../../components/ReadingSettings.astro';
---
<Layout title="阅读设置"><div class="narrow-page"><header class="page-head"><p class="eyebrow">我的书房</p><h1>让阅读更合心意</h1><p>选择舒适的外观和排版，设置会保存在此设备上。</p></header><ReadingSettings /><section class="related"><h2>个人资料</h2><p data-guest-only><a href="/auth/">登录后设置个人资料 →</a></p><form id="profile-form" class="form-stack" data-auth-only hidden><label>主页用户名<input name="username" pattern="[a-z][a-z0-9_]{2,39}" minlength="3" maxlength="40" required /><small>3–40 位小写字母、数字或下划线，以字母开头。</small></label><label>显示名称<input name="display_name" maxlength="60" required /></label><label>个人简介<textarea name="bio" maxlength="280"></textarea></label><button>保存个人资料</button></form></section></div></Layout>
