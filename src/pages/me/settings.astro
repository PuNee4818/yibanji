---
import Layout from '../../layouts/Layout.astro';
import ReadingSettings from '../../components/ReadingSettings.astro';
---

<Layout title="阅读设置">
  <div class="narrow-page">
    <header class="page-head">
      <p class="eyebrow">我的书房</p>
      <h1>让阅读更合心意</h1>
      <p>选择舒适的外观和排版，设置会保存在此设备上。</p>
    </header>
    <ReadingSettings />
    <p class="settings-profile-link">
      <a href="/me/">前往我的主页，编辑个人资料 →</a>
    </p>
  </div>
</Layout>
