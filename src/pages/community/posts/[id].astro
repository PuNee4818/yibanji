---
import Layout from '../../../layouts/Layout.astro';
import Discussion from '../../../components/Discussion.astro';
import { supabase } from '../../../lib/supabase';
export const prerender = false;
const { data: post } = await supabase
  .from('community_posts')
  .select('*')
  .eq('id', Astro.params.id ?? '')
  .eq('status', 'visible')
  .maybeSingle();
if (!post) Astro.response.status = 404;
---

<Layout title={post?.title || '书友帖子'}>
  {post ? (
    <section class="narrow-page" data-post-id={post.id}>
      <p>
        <a href="/community/">← 回到社区</a>
      </p>
      <h1 data-post-title>{post.title || '书友帖子'}</h1>
      <div data-post-body>
        <p>{post.content}</p>
      </div>
      {post.article_id && (
        <p>
          <a href={`/articles/${post.article_id}/`}>阅读引用的文章 →</a>
        </p>
      )}
      <Discussion kind="post_comment" target={post.id} />
    </section>
  ) : (
    <section class="empty-state">
      <h1>这篇帖子暂时无法查看</h1>
      <a href="/community/">回到社区</a>
    </section>
  )}
  <script>
    import '../../../scripts/community';
  </script>
</Layout>
