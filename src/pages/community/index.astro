---
import Layout from '../../layouts/Layout.astro';
import { book } from '../../lib/book';
---

<Layout title="社区">
  <header class="page-head community-head">
    <div>
      <p class="eyebrow">文字之外，还有回声</p>
      <h1>书友之间</h1>
      <p>读到喜欢的一句，或想起一件旧事，都可以在这里说。</p>
    </div>
    <a class="button primary" href="#compose" data-compose-open>
      写点感想 ↗
    </a>
  </header>
  <div class="community-layout">
    <section>
      <div id="compose" class="compose-section">
        <div class="guest-compose" data-guest-only>
          <span class="compose-glyph" aria-hidden="true">
            ✳
          </span>
          <div>
            <h2>你的这一页，写些什么？</h2>
            <p>登录后留下感想，回复书友，也可以引用一篇作品。</p>
            <a href="/auth/?next=/community/%23compose" class="text-link">
              登录参与 →
            </a>
          </div>
        </div>
        <form id="post-form" class="form-stack post-composer" data-auth-only hidden>
          <label>
            写一条动态
            <textarea
              name="content"
              maxlength="500"
              required
              placeholder="最近读到什么，或者想起了什么？"
            ></textarea>
          </label>
          <div class="composer-foot">
            <details>
              <summary>引用一篇文章</summary>
              <label>
                查找作品
                <input type="search" data-reference-search placeholder="篇名或作者" />
              </label>
              <label>
                引用一篇文章（可选）
                <select name="article_id">
                  <option value="">不引用文章</option>
                  {book.articles.map((a) => (
                    <option value={a.id} data-author={a.author}>
                      {a.title}
                    </option>
                  ))}
                </select>
              </label>
            </details>
            <span data-draft-count class="muted small">
              0 / 500
            </span>
            <button type="submit">发布动态</button>
          </div>
          <p data-post-status class="small" role="status"></p>
        </form>
      </div>
      <nav class="tabs" aria-label="社区动态分类">
        <a href="?tab=hot" data-feed-tab="hot">
          热门
        </a>
        <a href="?tab=latest" data-feed-tab="latest">
          最新
        </a>
        <a href="?tab=following" data-feed-tab="following">
          关注
        </a>
      </nav>
      <p class="muted small" data-feed-description>
        最近七天，书友正在聊的事。
      </p>
      <div data-feed aria-live="polite">
        <div class="skeleton" role="status" aria-label="正在加载讨论"></div>
      </div>
      <button data-more-feed hidden>
        查看更多动态
      </button>
    </section>
    <aside>
      <section class="community-guide">
        <span class="eyebrow">初次见面</span>
        <h2>从一篇文章开始</h2>
        <p>先读，再聊。喜欢的文字可以收藏，想再遇见的人可以关注。</p>
        <a href="/catalog/">挑一篇来读 →</a>
        <a href="/me/rewards/" data-auth-only hidden>
          看看我的墨迹 →
        </a>
      </section>
      <div data-highlights></div>
      <a class="community-rules" href="/community/guidelines/">
        社区规范 ↗
      </a>
    </aside>
  </div>
  <script>
    import '../../scripts/community';
  </script>
</Layout>
