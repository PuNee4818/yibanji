---
import Layout from '../layouts/Layout.astro';
import ArticleList from '../components/ArticleList.astro';
import { book } from '../lib/book';
---

<Layout title="目录">
  <header class="page-head">
    <p class="eyebrow">九卷 · 五十四篇</p>
    <h1>一班集目录</h1>
    <p>从故园出发，向天外行去。</p>
  </header>
  <div class="catalog-filter" aria-label="按文体筛选">
    <button data-genre-filter="" aria-pressed="true">
      全部
    </button>
    <button data-genre-filter="poetry" aria-pressed="false">
      诗歌
    </button>
    <button data-genre-filter="essay" aria-pressed="false">
      散文
    </button>
    <button data-genre-filter="story" aria-pressed="false">
      短篇小说
    </button>
    <button data-genre-filter="novel" aria-pressed="false">
      长篇小说
    </button>
  </div>
  <p data-catalog-count class="muted small" role="status"></p>
  <nav class="tabs" aria-label="卷目">
    {book.categories.map((c) => (
      <a href={`#${c.id}`}>{c.name}</a>
    ))}
  </nav>
  <div class="catalog-grid">
    {book.categories.map((c) => (
      <section id={c.id} data-volume={c.name}>
        <h2>{c.name}</h2>
        <ArticleList articles={book.articles.filter((a) => a.category === c.name)} />
      </section>
    ))}
  </div>
  <script>
    import '../scripts/catalog';
  </script>
</Layout>
