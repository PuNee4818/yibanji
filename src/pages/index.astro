---
import Layout from '../layouts/Layout.astro';
import HeroArt from '../components/HeroArt.astro';
import Icon from '../components/Icon.astro';
import { book, articleUrl } from '../lib/book';
import { genreOf, genreNames } from '../lib/presentation';
const prefaces = book.articles.filter((a) => a.category === '卷首');
const descriptions: Record<string, string> = {
  故园: '旧日校园，纸上重逢。',
  笑谈: '日子里的笑声与荒唐。',
  诗笺: '有些心事，只写成诗。',
  志异: '寻常之外，另有天地。',
  迷梦: '梦醒了，故事还在。',
  天外: '把想象交给远方。',
  剪刀: '一个世界的几种回声。',
};
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="red-dot"></span> 一班集 · 第二版
      </p>
      <h1>
        那时的风，
        <br />
        还在纸上。
      </h1>
      <p class="hero-description">
        课桌边的诗，晚自习的故事。
        <br />
        散场以后，我们把它们订成了一本书。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/catalog/">
          翻开文集 <Icon name="arrow" size={18} />
        </a>
        <span class="muted">九卷 · 五十四篇</span>
      </div>
    </div>
    <HeroArt />
  </section>
  <section class="reading-return" data-continue-reading hidden aria-label="继续上次阅读"></section>
  <section class="preface-strip" aria-label="三篇序言">
    <div class="preface-label">
      <span class="eyebrow">开卷之前</span>
      <h2>开卷三序</h2>
    </div>
    {prefaces.map((a, i) => (
      <a href={articleUrl(a)} class="preface-link">
        <span class="number">0{i + 1}</span>
        <span>
          <strong>{a.title}</strong>
          <small>{a.author}</small>
        </span>
        <Icon name="arrow" size={18} />
      </a>
    ))}
  </section>
  <section class="home-reading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">有人在读，也有人回望</p>
        <h2>此刻翻开的几页</h2>
      </div>
      <a href="/catalog/">全部作品 ↗</a>
    </div>
    <p class="muted small" data-hot-caption>
      先从这些作品读起，热文正在更新。
    </p>
    <div class="hot-works" data-hot-works>
      {['a03', 'a10', 'tianhuaban'].map((id, i) => {
        const a = book.articles.find((x) => x.id === id)!;
        return (
          <a class="hot-work" href={articleUrl(a)}>
            <span class="work-index">0{i + 1}</span>
            <span class="eyebrow">
              {genreNames[genreOf(a)]} / {a.category}
            </span>
            <h3>{a.title}</h3>
            <p>{a.author}</p>
            <span class="work-excerpt">
              {(a.body[0] ?? a.chapters?.[0]?.body[0] ?? '').slice(0, 60)}…
            </span>
            <span class="text-link">开始阅读 ↗</span>
          </a>
        );
      })}
    </div>
  </section>
  <section class="volume-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">循卷而读</p>
        <h2>各有天地</h2>
      </div>
      <span class="muted">从故园，走向天外</span>
    </div>
    <div class="volume-grid">
      {book.categories
        .filter((c) => descriptions[c.name])
        .map((c, i) => (
          <a class="volume-card" href={'/catalog/#' + c.id}>
            <span class="number">0{i + 1}</span>
            <div>
              <h3>{c.name}</h3>
              <p>{descriptions[c.name]}</p>
            </div>
            <span class="volume-meta">{c.articles.length} 篇 ↗</span>
          </a>
        ))}
    </div>
  </section>
  <section data-home-bookmarks hidden>
    <div class="section-heading">
      <h2>夹在书里的几页</h2>
      <a href="/me/bookmarks/">
        我的收藏 <span data-home-bookmark-count></span> →
      </a>
    </div>
    <div data-home-bookmark-list class="bookmark-strip"></div>
  </section>
  <section class="community-invitation">
    <div>
      <p class="eyebrow">读到这里，不妨坐一会儿</p>
      <h2>有句话，想和你说。</h2>
      <p>聊聊刚读到的故事，也聊聊你自己的。</p>
    </div>
    <a class="button" href="/community/">
      去书友之间 <Icon name="arrow" size={18} />
    </a>
  </section>
  <section class="recent-section">
    <div class="section-heading">
      <h2>纸上的回声</h2>
      <a href="/community/?tab=latest">最近讨论 →</a>
    </div>
    <div data-recent-discussions class="recent-grid">
      正在翻开讨论…
    </div>
  </section>
  <script>
    import '../scripts/home';
    import '../scripts/community';
  </script>
</Layout>
